# Copy to .env. Every value here is a local-development default; production values come from
# AWS Secrets Manager / ECS task definitions. Never commit real secrets.

# NODE_ENV is left unset on purpose: backends default to development, and Nx loads this file for
# every task, so setting it here would force a non-production NODE_ENV onto `next build`.
LOG_LEVEL=info
CURRENT_PHASE=0            # gateway /health/services checks services with phase <= this

# Infrastructure (docker compose)
# If another Postgres or Redis already uses 5432 / 6379 on this machine, uncomment and change the
# host ports below, and use the same ports in DATABASE_URL and REDIS_URL.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
DATABASE_URL=postgres://am:am@localhost:5432/african_market
RABBITMQ_URL=amqp://am:am@localhost:5672
REDIS_URL=redis://localhost:6379
TYPEORM_LOGGING=false
OUTBOX_POLL_MS=500

# Gateway
GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Deployed only. COOKIE_DOMAIN=.africanmarket.ae lets the web apps on sibling subdomains read the
# access cookie; TRUST_PROXY_HOPS=1 behind the load balancer so rate limits see the real caller.
# COOKIE_DOMAIN=
# TRUST_PROXY_HOPS=0
SERVICE_TIMEOUT_MS=5000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789

# Service hosts/ports (defaults in libs/contracts/src/services.ts). Override per service, e.g.:
# SHOPS_HOST=localhost
# SHOPS_TCP_PORT=4102
# SHOPS_HTTP_PORT=4202

# Media (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=am-minio
S3_SECRET_ACCESS_KEY=am-minio-secret
S3_PUBLIC_BUCKET=am-media-public
S3_PRIVATE_BUCKET=am-media-private
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/am-media-public

# Messaging providers (fake adapters when empty)
# Key for hashing one-time codes. Any 32+ characters locally; a real secret in staging/production.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0123456789
# Sends one-time codes on WhatsApp (default) and SMS (optional fallback).
SMS_PROVIDER=console        # console (prints the code to stdout, dev only) | twilio
EMAIL_PROVIDER=smtp         # smtp (Mailpit locally; SES through its SMTP endpoint) | ses (API, not built yet)
SMTP_URL=smtp://localhost:1025
# Only the tests read this: the Mailpit API they use to check that an email arrived.
MAILPIT_URL=http://localhost:8025
EMAIL_FROM="African Market <no-reply@africanmarket.local>"

# Social sign-in (Phase 1; disabled when empty)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontends
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# The customer site, as the seller app links to it (Terms, Privacy policy).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Payments (Phase 3; test-mode keys only outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_COMMISSION_BPS=800

# Observability (disabled when empty)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Windows only, and only if Next fails with "Failed to load native binding" / ERR_SWC_NATIVE_CACHE:
# SWC refuses its default cache (%LOCALAPPDATA%\swc) when another local account can write there.
# Point it at a folder only your user can write to. The web, seller and admin scripts read this
# file themselves, so it works however they are started.
# SWC_NATIVE_BINDING_CACHE=C:\ProgramData\swc-cache-<you>
