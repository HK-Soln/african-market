{
  "name": "stage: staging branch",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/stage"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["merge"],
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Format · Lint · Typecheck · Test · Build", "integration_id": 15368 },
          { "context": "Migrations (PostGIS)", "integration_id": 15368 },
          { "context": "Secret scan (gitleaks)", "integration_id": 15368 },
          { "context": "Dependency audit", "integration_id": 15368 },
          { "context": "PR source branch", "integration_id": 15368 }
        ]
      }
    }
  ]
}
