# Copy to .env. Every value here is for local development; staging and production values come
# from AWS Secrets Manager and the ECS task definitions. Never commit real secrets.
#
# Settings that differ between environments have no default in the code: leave one out and the
# service (or `next build`) stops at start and names it.

# NODE_ENV is left unset on purpose: backends default to development, and Nx loads this file for
# every task, so setting it here would force a non-production NODE_ENV onto `next build`.
LOG_LEVEL=info
CURRENT_PHASE=0            # gateway /health/services checks services with phase <= this

# Infrastructure (docker compose)
# If another Postgres or Redis already uses 5432 / 6379 on this machine, uncomment and change the
# host ports below, and use the same ports in DATABASE_URL and REDIS_URL.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
DATABASE_URL=postgres://am:am@localhost:5432/african_market
RABBITMQ_URL=amqp://am:am@localhost:5672
REDIS_URL=redis://localhost:6379
TYPEORM_LOGGING=false
OUTBOX_POLL_MS=500

# Gateway
GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Deployed only. COOKIE_DOMAIN=.africanmarket.ae lets the web apps on sibling subdomains read the
# access cookie; TRUST_PROXY_HOPS=1 behind the load balancer so rate limits see the real caller.
# COOKIE_DOMAIN=
TRUST_PROXY_HOPS=0
SERVICE_TIMEOUT_MS=5000
# Scales the per-IP limits on the auth routes (default 1); only the end-to-end stack raises it.
# AUTH_THROTTLE_MULTIPLIER=1
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789

# Where the gateway reaches each service. Ports default to libs/contracts/src/services.ts and
# can be overridden per service, e.g. SHOPS_TCP_PORT=4102, SHOPS_HTTP_PORT=4202.
IDENTITY_HOST=localhost
SHOPS_HOST=localhost
CATALOG_HOST=localhost
DISCOVERY_HOST=localhost
MEDIA_HOST=localhost
MESSAGING_HOST=localhost
NOTIFICATIONS_HOST=localhost
ORDERS_HOST=localhost
PAYMENTS_HOST=localhost

# Media (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=am-minio
S3_SECRET_ACCESS_KEY=am-minio-secret
# Three buckets (decision T-27): browsers upload only to the quarantine bucket; the media service
# checks each file and stores it in public (images, read through the CDN) or private (documents).
S3_UPLOADS_BUCKET=am-media-uploads
S3_PUBLIC_BUCKET=am-media-public
S3_PRIVATE_BUCKET=am-media-private
# Local MinIO only: create the buckets at start and let anyone read the public one. Refused in AWS.
S3_CREATE_BUCKETS=true
# The storage address as the browser reaches it, when it differs from S3_ENDPOINT (containers).
# S3_PRESIGN_ENDPOINT=http://localhost:9000
# AWS only: the CloudFront distribution to purge removed public images from.
# CLOUDFRONT_DISTRIBUTION_ID=
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/am-media-public

# Messaging providers (fake adapters when empty)
# Key for hashing one-time codes. Any 32+ characters locally; a real secret in staging/production.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0123456789
# Sends one-time codes on WhatsApp (default) and SMS (optional fallback).
SMS_PROVIDER=console        # console (prints the code to stdout, dev only) | twilio
# Optional: numbers with a fixed code that is never sent (end-to-end tests). Refused in production.
# OTP_TEST_NUMBERS=+971500000001:135790,+971500000002:246801
EMAIL_PROVIDER=smtp         # smtp (Mailpit locally; SES through its SMTP endpoint) | ses (API, not built yet)
# Any provider with an SMTP endpoint works without code changes, e.g. Resend:
# SMTP_URL=smtps://resend:<api key>@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
# Only the tests read this: the Mailpit API they use to check that an email arrived.
MAILPIT_URL=http://localhost:8025
EMAIL_FROM="African Market <no-reply@africanmarket.local>"

# Social sign-in (Phase 1; disabled when empty)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontends
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# The customer site, as the seller app links to it (Terms, Privacy policy).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Payments (Phase 3; test-mode keys only outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_COMMISSION_BPS=800

# Observability: each part is off while its key is empty, and every app says at start what is on.
# Traces (OpenTelemetry, backends): spans and trace ids in logs always; sent over OTLP/HTTP only
# when an endpoint is set. Locally: docker compose --profile tracing up -d jaeger, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 and http://localhost:16686 to look.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Share of new traces kept, 0 to 1. Default shown.
# OTEL_TRACES_SAMPLE_RATIO=1
# Error reports (Sentry). Backends read SENTRY_DSN when they start; the Next apps have theirs
# compiled in at build time, with the environment name it is filed under (required with a DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Waits before each retry of a failed event, in ms; then it is dead-lettered. Default shown.
# EVENT_RETRY_DELAYS_MS=5000,30000,120000

# Windows only, and only if Next fails with "Failed to load native binding" / ERR_SWC_NATIVE_CACHE:
# SWC refuses its default cache (%LOCALAPPDATA%\swc) when another local account can write there.
# Point it at a folder only your user can write to. The web, seller and admin scripts read this
# file themselves, so it works however they are started.
# SWC_NATIVE_BINDING_CACHE=C:\ProgramData\swc-cache-<you>
