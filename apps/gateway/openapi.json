  "info": {
    "title": "African Market API",
    "description": "Gateway REST API for the web, seller and admin apps",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "am_at"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+971501234567",
            "description": "Any format; UAE is assumed without +."
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "sms"
            ],
            "default": "whatsapp"
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpRequestedDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "The phone in E.164; send this back when verifying."
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "sms"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAfterSeconds": {
            "type": "number",
            "description": "Seconds to wait before asking for another code."
          }
        },
        "required": [
          "phone",
          "channel",
          "expiresAt",
          "resendAfterSeconds"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+971501234567"
          },
          "code": {
            "type": "string",
            "example": "482913"
          },
          "termsAccepted": {
            "type": "boolean",
            "description": "Must be true when this creates the account."
          },
          "marketingConsent": {
            "type": "boolean"
          },
          "preferredLanguage": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "fr"
            ]
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+971501234567"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "preferredLanguage": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "fr"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "customer",
                "seller",
                "admin"
              ]
            }
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "homeEmirate": {
            "type": "string",
            "nullable": true,
            "example": "DXB"
          },
          "marketingConsent": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "phone",
          "email",
          "name",
          "preferredLanguage",
          "roles",
          "phoneVerified",
          "emailVerified",
          "homeEmirate",
          "marketingConsent",
          "createdAt"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          },
          "isNewUser": {
            "type": "boolean",
            "description": "True when this call created the account."
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "isNewUser",
          "accessToken",
          "accessTokenExpiresAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amina@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "termsAccepted": {
            "type": "boolean",
            "description": "Must be true."
          },
          "marketingConsent": {
            "type": "boolean"
          },
          "preferredLanguage": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "fr"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "termsAccepted"
        ]
      },
      "EmailCodeSentDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAfterSeconds": {
            "type": "number",
            "description": "Seconds to wait before asking for another code."
          }
        },
        "required": [
          "email",
          "expiresAt",
          "resendAfterSeconds"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amina@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amina@example.com"
          },
          "code": {
            "type": "string",
            "example": "482913"
          },
          "password": {
            "type": "string",
            "description": "The password chosen at registration, sent again."
          }
        },
        "required": [
          "email",
          "code",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amina@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "amina@example.com"
          },
          "code": {
            "type": "string",
            "example": "482913"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "LoggedOutDto": {
        "type": "object",
        "properties": {
          "loggedOut": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "loggedOut"
        ]
      },
      "ShopMembershipDto": {
        "type": "object",
        "properties": {
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "staff"
            ]
          },
          "branchIds": {
            "description": "Empty means every branch.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "shopId",
          "role",
          "branchIds"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          },
          "shops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopMembershipDto"
            }
          }
        },
        "required": [
          "user",
          "shops"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "preferredLanguage": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "fr"
            ]
          },
          "homeEmirate": {
            "type": "string",
            "nullable": true,
            "enum": [
              "DXB",
              "AUH",
              "SHJ",
              "AJM",
              "UAQ",
              "RAK",
              "FUJ"
            ]
          },
          "marketingConsent": {
            "type": "boolean",
            "description": "True records consent now; false withdraws it."
          }
        }
      }
    }
  }
}