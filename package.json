{
  "name": "african-market",
  "version": "0.0.0",
  "private": true,
  "description": "Location-first marketplace for African shops, products and services in the UAE",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build --projects='tag:lib'",
    "dev": "nx run-many -t dev --parallel=20 --output-style=stream",
    "dev:api": "nx run-many -t dev --projects='tag:backend' --parallel=20 --output-style=stream",
    "dev:web": "nx run-many -t dev --projects='tag:frontend' --parallel=5 --output-style=stream",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint typecheck test build",
    "migration:run": "nx run-many -t migration:run --projects='tag:db' --parallel=1",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nx": "21.6.11",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
