# Copy to .env. Every value here is for local development; staging and production values come
# from AWS Secrets Manager and the ECS task definitions. Never commit real secrets.
#
# No setting has a default in the code (decision T-45): leave one out, or leave it empty, and
# the service (or `next build`) stops at start and names it. A feature that can be off is set to
# `none` (`SENTRY_DSN=none`), so a forgotten value is never mistaken for "off". Not an empty
# value: AWS drops empty environment variables, so `none` means the same thing everywhere.

# Which environment this is: development | test | staging | production. Safety checks read it
# (fakes and test routes are refused in staging and production). NODE_ENV is left to Next and
# React, which set it themselves; do not set it here (Nx loads this file into `next build`).
DEPLOY_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty          # pretty (a person reading a terminal) | json (one line per entry)
CURRENT_PHASE=0            # gateway /health/services checks services with phase <= this

# Infrastructure (docker compose). The host ports compose publishes; if another Postgres or
# Redis already uses 5432 / 6379 on this machine, change them, and use the same ports in
# DATABASE_URL and REDIS_URL.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=4000
WEB_HOST_PORT=3000
DATABASE_URL=postgres://am:am@localhost:5432/african_market
RABBITMQ_URL=amqp://am:am@localhost:5672
REDIS_URL=redis://localhost:6379
TYPEORM_LOGGING=false
OUTBOX_POLL_MS=500
# The topic exchange events are published to, and the waits before each retry of a failed event
# (ms); after the last one it is dead-lettered.
EVENTS_EXCHANGE=am.events
EVENT_RETRY_DELAYS_MS=5000,30000,120000

# Gateway
GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Deployed: COOKIE_DOMAIN=.africanmarket.ae lets the web apps on sibling subdomains read the
# access cookie (`none`: this host only); TRUST_PROXY_HOPS=1 behind the load balancer so rate
# limits see the real caller.
COOKIE_DOMAIN=none
# Auth cookies over HTTPS only: true wherever the gateway is served over HTTPS (required in
# staging and production); false for plain http here.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
SERVICE_TIMEOUT_MS=5000
# Scales the per-IP limits on the auth routes; 1 everywhere real, only the end-to-end stack raises it.
AUTH_THROTTLE_MULTIPLIER=1
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
# GET /api/v1/test/otp (gateway) and its handler (identity): hand out the code the in-memory SMS
# provider "sent", for the end-to-end tests. Refused in staging and production.
TEST_SUPPORT_ROUTES=false

# Where each service listens, and where the gateway reaches it: the usual ports are in
# libs/contracts/src/services.ts.
IDENTITY_HOST=localhost
IDENTITY_TCP_PORT=4101
IDENTITY_HTTP_PORT=4201
SHOPS_HOST=localhost
SHOPS_TCP_PORT=4102
SHOPS_HTTP_PORT=4202
CATALOG_HOST=localhost
CATALOG_TCP_PORT=4103
CATALOG_HTTP_PORT=4203
DISCOVERY_HOST=localhost
DISCOVERY_TCP_PORT=4104
DISCOVERY_HTTP_PORT=4204
MEDIA_HOST=localhost
MEDIA_TCP_PORT=4105
MEDIA_HTTP_PORT=4205
MESSAGING_HOST=localhost
MESSAGING_TCP_PORT=4106
MESSAGING_HTTP_PORT=4206
NOTIFICATIONS_HOST=localhost
NOTIFICATIONS_TCP_PORT=4107
NOTIFICATIONS_HTTP_PORT=4207
ORDERS_HOST=localhost
ORDERS_TCP_PORT=4108
ORDERS_HTTP_PORT=4208
PAYMENTS_HOST=localhost
PAYMENTS_TCP_PORT=4109
PAYMENTS_HTTP_PORT=4209

# Media (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=am-minio
S3_SECRET_ACCESS_KEY=am-minio-secret
# Three buckets (decision T-27): browsers upload only to the quarantine bucket; the media service
# checks each file and stores it in public (images, read through the CDN) or private (documents).
S3_UPLOADS_BUCKET=am-media-uploads
S3_PUBLIC_BUCKET=am-media-public
S3_PRIVATE_BUCKET=am-media-private
# Local MinIO only: create the buckets at start and let anyone read the public one. Refused in AWS.
S3_CREATE_BUCKETS=true
# The storage address as the browser reaches it, when it differs from S3_ENDPOINT (containers);
# none when it is the same.
S3_PRESIGN_ENDPOINT=none
# AWS only: the CloudFront distribution to purge removed public images from; none here.
CLOUDFRONT_DISTRIBUTION_ID=none

# Seller identity verification (F1-03, decision T-28). `fake` approves at once (local work and
# tests; refused in staging and production). `didit` sends the owner to Didit's hosted page; its
# webhook reaches the gateway at /api/v1/webhooks/didit, and the result is also fetched when the
# seller comes back, so it works locally without webhooks.
KYC_PROVIDER=fake
# The seller app, where the hosted page sends the seller back.
SELLER_APP_URL=http://localhost:3001
# With KYC_PROVIDER=didit (Didit Console > API & Webhooks), all four; none with `fake`.
# DIDIT_API_SECRET is the webhook destination's shared secret, which signs the webhooks.
# DIDIT_API_URL=https://verification.didit.me
DIDIT_API_URL=none
DIDIT_API_KEY=none
DIDIT_API_SECRET=none
DIDIT_WORKFLOW_ID=none
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/am-media-public

# Messaging providers (fake adapters when empty)
# Key for hashing one-time codes. Any 32+ characters locally; a real secret in staging/production.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0123456789
# Sends one-time codes on WhatsApp (default) and SMS (optional fallback).
SMS_PROVIDER=console        # console (prints the code to stdout, dev only) | twilio
# Numbers with a fixed code that is never sent (end-to-end tests), e.g.
# +971500000001:135790,+971500000002:246801; none for none. Refused in production.
OTP_TEST_NUMBERS=none
# Social sign-in (F1-09): google, facebook, both, or empty for none. With google, set
# GOOGLE_CLIENT_IDS (web and seller client ids, comma-separated); with facebook, FACEBOOK_APP_ID and
# FACEBOOK_APP_SECRET (none otherwise). `none` keeps the sign-in screens to phone and email.
SOCIAL_PROVIDERS=none
# e.g. 000000000000-web.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=none
FACEBOOK_APP_ID=none
FACEBOOK_APP_SECRET=none
# Accept made-up social tokens instead of asking Google and Facebook (tests). Anyone could then
# sign in as anyone: refused in staging and production.
FAKE_SOCIAL_SIGN_IN=false
EMAIL_PROVIDER=smtp         # smtp (Mailpit locally; SES through its SMTP endpoint) | ses (API, not built yet)
# Any provider with an SMTP endpoint works without code changes, e.g. Resend:
# SMTP_URL=smtps://resend:<api key>@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
# Only the tests read this: the Mailpit API they use to check that an email arrived.
MAILPIT_URL=http://localhost:8025
EMAIL_FROM="African Market <no-reply@africanmarket.local>"

# Frontends
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# The customer site, as the seller app links to it (Terms, Privacy policy).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# The seller app, as the customer site links to it (For sellers).
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
# The gateway as the Next servers reach it (the same as the browser's address here).
GATEWAY_URL=http://localhost:4000
# Google Maps in the customer site (map, place search). none: lists and an emirate choice only.
# A browser key limited to the site's addresses; with it, the map id from Map Management
# (DEMO_MAP_ID, Google's test id, is fine locally).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=none
NEXT_PUBLIC_GOOGLE_MAP_ID=none
# Names a build, so a new deploy replaces the pages the service worker precached (the commit in
# CI and the images), and the folder `next build` writes to.
BUILD_ID=local
NEXT_DIST_DIR=.next

# Payments (Phase 3; test-mode keys only outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=none
PLATFORM_COMMISSION_BPS=800

# Observability: each part is off while its key is none, and every app says at start what is on.
# Traces (OpenTelemetry, backends): spans and trace ids in logs always; sent over OTLP/HTTP only
# when an endpoint is set. Locally: docker compose --profile tracing up -d jaeger, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 and http://localhost:16686 to look.
OTEL_EXPORTER_OTLP_ENDPOINT=none
# Share of new traces kept, 0 to 1.
OTEL_TRACES_SAMPLE_RATIO=1
# Error reports (Sentry). Backends read SENTRY_DSN when they start; the Next apps have theirs
# compiled in at build time, with the environment name it is filed under (required with a DSN).
SENTRY_DSN=none
NEXT_PUBLIC_SENTRY_DSN=none
NEXT_PUBLIC_SENTRY_ENVIRONMENT=none


# Windows only, and only if Next fails with "Failed to load native binding" / ERR_SWC_NATIVE_CACHE:
# SWC refuses its default cache (%LOCALAPPDATA%\swc) when another local account can write there.
# Point it at a folder only your user can write to. The web, seller and admin scripts read this
# file themselves, so it works however they are started.
# SWC_NATIVE_BINDING_CACHE=C:\ProgramData\swc-cache-<you>
