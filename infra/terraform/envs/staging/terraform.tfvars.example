# Copy to terraform.tfvars. Nothing here is secret; secrets live in Secrets Manager.
# africanmarket.ae is being bought (2026-10); staging lives on its subdomain.
domain = "staging.africanmarket.ae"

# Email: "ses" (default), or "smtp" for any other provider such as Resend (see README, Email).
# email_provider = "smtp"

# The Route 53 hosted zone of the domain, if DNS is there; records are then created for you.
# Leave it out when DNS is elsewhere and add the `dns_records` output by hand.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Error reports (Sentry): off while empty. Sentry keeps data outside the UAE; see DECISIONS T-22
# before turning it on. Traces go to X-Ray in this region whatever is set here.
# sentry_dsn_backend  = "https://<key>@<org>.ingest.de.sentry.io/<project>"
# sentry_dsn_frontend = "https://<key>@<org>.ingest.de.sentry.io/<project>"

# Seller identity verification: the Didit workflow id (not secret). The API key and the webhook
# secret go in Secrets Manager by hand: african-market/<env>/DIDIT_API_KEY and DIDIT_API_SECRET.
didit_workflow_id = "00000000-0000-0000-0000-000000000000"
