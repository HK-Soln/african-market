{
  "name": "@am/identity",
  "version": "0.0.0",
  "private": true,
  "description": "identity service: Users, credentials, OTP, sessions and refresh tokens, roles, shop memberships, saved addresses",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js"
  },
  "nx": {
    "tags": [
      "app",
      "backend",
      "db",
      "phase:0"
    ],
    "targets": {
      "migration:run": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:revert": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:generate": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@am/auth": "workspace:*",
    "@am/contracts": "workspace:*",
    "@am/core": "workspace:*",
    "@am/database": "workspace:*",
    "@am/geo": "workspace:*",
    "@am/i18n": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
