{
  "name": "@am/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components, design tokens and component styles for the three Next.js apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "theme.css",
    "components.css",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests"
  },
  "nx": {
    "tags": [
      "lib",
      "frontend-lib"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@am/contracts": "workspace:*",
    "@am/i18n": "workspace:*",
    "libphonenumber-js": "^1.13.15",
    "country-flag-icons": "^1.6.20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./components.css": "./components.css"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react-dom": "^19.3.0"
  }
}
