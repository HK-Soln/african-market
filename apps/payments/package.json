{
  "name": "@am/payments",
  "version": "0.0.0",
  "private": true,
  "description": "payments service: Stripe Connect onboarding, payment intents (direct charges + application fee), webhook mirror, refunds, payout status",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js"
  },
  "nx": {
    "tags": [
      "app",
      "backend",
      "db",
      "phase:3"
    ],
    "targets": {
      "migration:run": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:revert": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:generate": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@am/contracts": "workspace:*",
    "@am/core": "workspace:*",
    "@am/database": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  }
}
