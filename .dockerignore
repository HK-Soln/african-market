# The build context is the whole repository (the images build libs and apps with Nx), so keep
# out everything that is built, installed or local to a machine.
**/node_modules
**/dist
**/.next
**/.next-e2e
**/out
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
.nx
.git
.github
.vscode
.idea
.logs
*.log

# Secrets and machine settings never go into an image.
.env
.env.*
.history
!.env.example

# Generated by the web build from src/sw.ts.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# Not needed to build or run an app.
e2e/test-results
e2e/playwright-report
infra/terraform
docs
