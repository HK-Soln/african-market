{
  "name": "@am/media",
  "version": "0.0.0",
  "private": true,
  "description": "media service: Presigned uploads to S3/MinIO, image resizing, CDN URLs",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js"
  },
  "nx": {
    "tags": [
      "app",
      "backend",
      "db",
      "phase:1"
    ],
    "targets": {
      "migration:run": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:revert": {
        "dependsOn": [
          "build"
        ]
      },
      "migration:generate": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@am/contracts": "workspace:*",
    "@am/core": "workspace:*",
    "@am/database": "workspace:*",
    "@aws-sdk/client-cloudfront": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  }
}
