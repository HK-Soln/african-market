{
  "name": "@am/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the gateway REST API (generated from OpenAPI)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "generate": "openapi-typescript ../../apps/gateway/openapi.json -o src/schema.ts"
  },
  "nx": {
    "tags": [
      "lib",
      "frontend-lib"
    ],
    "targets": {
      "generate": {
        "dependsOn": [
          "@am/gateway:openapi"
        ]
      }
    }
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
